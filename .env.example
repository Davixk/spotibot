# ---- Server ----
PORT=8080
NODE_ENV=production

# Public base URL this server is reachable at. Used to render the exact Spotify
# redirect URI you must register in each Spotify app (PUBLIC_BASE_URL + /api/spotify/callback).
PUBLIC_BASE_URL=http://localhost:8080

# ---- Dashboard auth (single password gate for the whole web UI) ----
DASHBOARD_PASSWORD=change-me-please
# Must be at least 32 characters. Used to sign session cookies.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Secret encryption ----
# 32 raw bytes, base64-encoded, used for AES-256-GCM encryption of Spotify client
# secrets and refresh tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ---- Postgres ----
DATABASE_URL=postgres://spotibot:spotibot@localhost:5432/spotibot
