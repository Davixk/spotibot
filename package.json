{
  "name": "spotibot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "pnpm --filter @spotibot/shared run build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm run build:shared && pnpm --filter @spotibot/server run typecheck && pnpm --filter @spotibot/web run typecheck",
    "lint": "pnpm run build:shared && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @spotibot/server run test",
    "db:generate": "pnpm --filter @spotibot/server run db:generate",
    "dev": "pnpm -r --parallel run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
